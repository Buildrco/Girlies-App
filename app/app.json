{
  "expo": {
    "name": "Girlies",
    "slug": "girlies-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "girlies",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Girlies needs access to your photos and videos so you can share them with the community.",
          "cameraPermission": "Girlies needs camera access so you can take photos and videos to share.",
          "microphonePermission": "Girlies needs microphone access when you record videos."
        }
      ]
    ],
    "android": {
      "package": "com.girlies.app"
    },
    "ios": {
      "bundleIdentifier": "com.girlies.app"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a7fa9be0-c509-4086-9421-47e3df9c5dfa",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "eas": {
        "projectId": "a7fa9be0-c509-4086-9421-47e3df9c5dfa"
      }
    }
  }
}
